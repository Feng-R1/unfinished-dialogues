# Copy to .env.local. Leaving all three MODEL_* values empty enables the labelled demo.
# Configure an OpenAI-compatible Chat Completions endpoint; use your provider's values.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# DeepSeek official base URL: https://api.deepseek.com
# Latest Flash alias (verified 2026-10-18): deepseek-flash -> DeepSeek-V4.1-Flash-1017.
# Real requests may incur your provider's charges. Never commit .env.local.
NEXT_TELEMETRY_DISABLED=1
